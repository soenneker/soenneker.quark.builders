<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <EnumValuesInlining>NoInlining</EnumValuesInlining>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <RootNamespace>Soenneker.Quark</RootNamespace>
        <GenerateDefaultNamespace>false</GenerateDefaultNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Builders that allow for Quark fluent chaining of Shadcn and Tailwind classes</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Quark.Builders</AssemblyName>
        <PackageId>Soenneker.Quark.Builders</PackageId>
        <PackageTags>quark builders builder fluent tailwind shadcn quarkbuilders util csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.quark.builders</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.quark.builders</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.String" Version="4.0.766" />
        <PackageReference Include="Soenneker.Quark.Enums.Breakpoints" Version="4.0.68" />
        <PackageReference Include="Soenneker.Quark.Enums.ColorPalettes" Version="4.0.27" />
        <PackageReference Include="Soenneker.Quark.Enums.DisplayTypes" Version="4.0.79" />
        <PackageReference Include="Soenneker.Quark.Enums.Overflows" Version="4.0.81" />
        <PackageReference Include="Soenneker.Quark.Enums.Positions" Version="4.0.77" />
        <PackageReference Include="Soenneker.Quark.Enums.TextAlignments" Version="4.0.77" />
        <PackageReference Include="Soenneker.Quark.Enums.TextTransforms" Version="4.0.72" />
        <PackageReference Include="Soenneker.Quark.Gen.Tailwind.Modifiers" Version="4.0.20">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Optional verification of a coordinated generator release; normal builds use NuGet. -->
    <Target Name="UseQuarkTailwindModifiersVerificationAnalyzer" BeforeTargets="CoreCompile" Condition="'$(QuarkTailwindModifiersAnalyzerPath)' != ''">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'Soenneker.Quark.Gen.Tailwind.Modifiers'" />
            <Analyzer Include="$(QuarkTailwindModifiersAnalyzerPath)" />
        </ItemGroup>
    </Target>
</Project>
